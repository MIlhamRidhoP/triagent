# Salin menjadi .env (diabaikan git). Isi hanya saat fase yang membutuhkannya.
# Jangan pernah commit .env atau menempel nilai kunci ke pesan commit, log, atau laporan.

# Kunci penyedia model untuk eval berbayar (Fase 4 ke atas)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Batas biaya per perintah eval berbayar, dalam USD (SPEC bagian 6)
TRIAGENT_MAX_USD_PER_INVOCATION=5

# Token untuk adapter SonarCloud dan klien PR GitHub (Fase 6), opsional
SONAR_TOKEN=
GITHUB_TOKEN=
