# Pengaturan guard kuota. Dibaca oleh guard.sh.
#
# GUARD_LIMIT: persen meter MINGGUAN (nilai absolut yang tampil di /usage).
# Agent dihentikan sebelum pemanggilan alat berikutnya begitu meter >= nilai ini.
# Pasang beberapa poin di bawah target, karena pengecekan hanya terjadi sebelum
# tiap pemanggilan alat. Meter kembali ke 0 saat reset mingguan, jadi sesuaikan
# nilainya setelah reset.
GUARD_LIMIT=30

# Data limit yang lebih tua dari ini (detik) dianggap basi.
GUARD_STALE_SECONDS=900

# GUARD_STRICT=1: bila data limit tidak tersedia atau basi, hentikan agent.
# GUARD_STRICT=0: bila tidak tersedia, izinkan (data baru ada setelah respons
# pertama sesi). Setelah guard terbukti bekerja di mesinmu, 1 lebih aman.
GUARD_STRICT=0
